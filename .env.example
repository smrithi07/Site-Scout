# Copy to .env and fill in. .env is git-ignored; never commit real values.
# After editing .env: `make reload-env` (containers read it only when created).

# PostGIS (the db container creates this user/database on first start)
POSTGRES_USER=sitescout
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sitescout
DATABASE_URL=postgresql+psycopg://sitescout:change-me@db:5432/sitescout

# Demo auth: bearer tokens are HMAC(APP_SECRET, user id). At least 16 characters.
APP_SECRET=replace-with-a-long-random-string
DEMO_AUTH=true

# LLM narration (optional). With no keys, every narrative falls back to the deterministic template.
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_MODEL=

# Savomart Stores API token — used only to download the store list offline (see README §Setup).
SAVO_STORES_TOKEN=
